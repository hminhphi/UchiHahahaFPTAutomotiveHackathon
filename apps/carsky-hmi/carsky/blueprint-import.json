        {
          "id": "node-ivi-gw",
          "label": "IVI Gateway",
          "nodeType": "script-node",
          "config": {
            "script": "inline",
            "scriptContent": "-- ivi_gateway.lua\n-- Bridges Vehicle KUKSA VSS signals to IVI Android VHAL.\n-- coaching-bridge publishes coaching commands to KUKSA;\n-- this gateway forwards them to VHAL properties on the Android guest.\n\nlocal kuksa = pins.kuksa\nassert(kuksa and kuksa.vss, \"pins.kuksa.vss missing\")\n\nlocal Vehicle = kuksa.vss.Vehicle\n\n-- Forward Vehicle.Speed to VHAL PERF_VEHICLE_SPEED (0x11600207)\nif Vehicle and Vehicle.Speed then\n  Vehicle.Speed:on_change(function(v)\n    if pins.vhal then\n      pins.vhal:set(0x11600207, 0, v or 0)\n    end\n  end)\nend\n\nlog(\"ivi_gateway ready\")\n"
          },
          "positionX": 850,
          "positionY": -100,
          "pins": [
            {
              "id": "pin-ivigw-kuksa",
              "name": "kuksa",
              "pinType": "KUKSA",
              "direction": "OUTPUT",
              "side": null
            },
            {
              "id": "pin-ivigw-vhal",
              "name": "vhal",
              "pinType": "VHAL",
              "direction": "INPUT",
              "side": null
            },
            {
              "id": "pin-ivigw-eth",
              "name": "eth",
              "pinType": "GENERIC",
              "direction": "OUTPUT",
              "side": null
            }
          ]
        },
